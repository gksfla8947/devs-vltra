# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# backups (로컬 전용, 민감 데이터 포함)
/backups/

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# agent settings
/.claude
/.vscode
/CLAUDE.md

